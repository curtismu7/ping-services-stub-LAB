# Settings file for ping-services-stub-LAB. Copy to the file STANDALONE_ENV names
# (default ~/Development/.env), chmod 600. Never commit the real file.
# Real needs the three PingOne worker values; everything else is optional.
PINGONE_ENVIRONMENT_ID=
PINGONE_REGION=com
PINGONE_CLIENT_ID=
PINGONE_CLIENT_SECRET=
# Your own PingOne Privilege Agent Gateway (no default; the row says "not configured" until set).
PRIVILEGE_GATEWAY_URL=
# PingOne Privilege console reachability probe (optional).
PRIVILEGE_CONSOLE_URL=
# An SE PingFederate to probe (optional).
SE_PF_URL=
# pi.flow sign-in at ping-shared's PingFederate (the TRACE_PF_CLIENT_ID / TRACE_PF_CLIENT_SECRET
# environment variables win over these).
PF_EXCHANGE_CLIENT_ID=id-jag-kit
PF_EXCHANGE_CLIENT_SECRET=
# Probe targets default to ping-shared (PingFederate 127.0.0.1:4732, PingGateway 127.0.0.1:7809).
# Set these in the environment (or compose) to repoint: PINGFEDERATE_HOST/PORT,
# PINGGATEWAY_HOST/PORT or PINGGATEWAY_HOST_PORT, EXERCISE_PF_BASE, EXERCISE_PG_BASE, EXERCISE_PRIV_BASE.
